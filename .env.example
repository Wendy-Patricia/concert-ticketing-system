MYSQL_PORT=3306
MYSQL_DATABASE=concert_ticketing
MYSQL_USER=concert_app
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# Variables a exporter aussi dans le processus Java (Spring ne lit pas .env).
MYSQL_HOST=127.0.0.1
APP_TIME_ZONE=Europe/Paris
SERVER_PORT=8080
# Alternative facultative : SPRING_DATASOURCE_URL, SPRING_DATASOURCE_USERNAME
# et SPRING_DATASOURCE_PASSWORD peuvent remplacer le datasource complet.
